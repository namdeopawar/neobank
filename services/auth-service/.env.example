NODE_ENV=development
PORT=3001
APP_VERSION=1.0.0
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neobank_auth
DB_USER=neobank
DB_PASSWORD=neobank_secret
REDIS_URL=redis://localhost:6379
